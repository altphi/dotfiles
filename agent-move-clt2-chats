#!/usr/bin/env bash
# Move Grok sessions for every repo now in /srv/code into the agent
# account, and point each recorded workspace at the new path.
# Also copies theme and user settings. Does not copy auth.json.
set -euo pipefail

if [[ "${EUID}" -ne 0 ]]; then
  exec sudo -H "$0" "$@"
fi

sessions=/home/stephen/.grok/sessions
agent_grok=/home/agent/.grok
dest_root="${agent_grok}/sessions"
srv=/srv/code

install -d -m 700 -o agent -g work "${agent_grok}" "${dest_root}"

install -m 600 -o agent -g work /home/stephen/.grok/config.toml "${agent_grok}/config.toml"
install -m 644 -o agent -g work /home/stephen/.grok/AGENTS.md "${agent_grok}/AGENTS.md"

trust=$(mktemp)
trap 'rm -f "${trust}"' EXIT
{
  for dir in "${srv}"/*/; do
    [[ -d "${dir}" ]] || continue
    repo=${dir%/}
    printf '[folders."%s"]\ntrusted = true\n\n' "${repo}"
  done
} >"${trust}"
install -m 600 -o agent -g work "${trust}" "${agent_grok}/trusted_folders.toml"

/run/current-system/sw/bin/node --input-type=module <<'JS'
import { readdir, readFile, writeFile, rename, stat } from "node:fs/promises";
import { spawnSync } from "node:child_process";
import path from "node:path";

const sessions = "/home/stephen/.grok/sessions";
const destRoot = "/home/agent/.grok/sessions";
const srv = "/srv/code";
const oldPrefix = "/home/stephen/code/";
const newPrefix = "/srv/code/";
const oldGrok = "/home/stephen/.grok";
const newGrok = "/home/agent/.grok";
const names = new Set(["summary.json", "prompt_context.json", "plan.json", "meta.json"]);

const tops = new Set();
for (const name of await readdir(srv)) {
  const st = await stat(path.join(srv, name));
  if (st.isDirectory()) tops.add(name);
}

function retarget(text, oldCwd, newCwd) {
  const escaped = oldCwd.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  const next = text.replace(new RegExp(escaped + "(?=/|$)", "g"), newCwd);
  return next.split(oldGrok).join(newGrok);
}

async function rewrite(dir, oldCwd, newCwd) {
  let files = 0;
  async function walk(current) {
    for (const entry of await readdir(current, { withFileTypes: true })) {
      const full = path.join(current, entry.name);
      if (entry.isDirectory()) {
        await walk(full);
        continue;
      }
      if (!names.has(entry.name)) continue;
      const text = await readFile(full, "utf8");
      const next = retarget(text, oldCwd, newCwd);
      if (next === text) continue;
      await writeFile(full, next);
      files += 1;
    }
  }
  await walk(dir);
  return files;
}

let moved = 0;
let skipped = 0;
for (const name of (await readdir(sessions)).sort()) {
  let cwd;
  try {
    cwd = decodeURIComponent(name);
  } catch {
    continue;
  }
  if (!cwd.startsWith(oldPrefix)) continue;
  const rel = cwd.slice(oldPrefix.length);
  const top = rel.split("/")[0];
  if (!tops.has(top)) continue;
  const newCwd = newPrefix + rel;
  const src = path.join(sessions, name);
  const dest = path.join(destRoot, encodeURIComponent(newCwd));
  if (await stat(dest).then(() => true, () => false)) {
    console.log(`skip ${rel}: destination exists`);
    skipped += 1;
    continue;
  }
  const files = await rewrite(src, cwd, newCwd);
  await rename(src, dest);
  const chown = spawnSync("chown", ["-R", "agent:work", dest], { stdio: "inherit" });
  if (chown.status !== 0) process.exit(chown.status ?? 1);
  const sessionsInGroup = (await readdir(dest)).filter((entry) => !entry.startsWith(".")).length;
  console.log(`moved ${rel} -> ${newCwd} (${sessionsInGroup} sessions, ${files} metadata files)`);
  moved += 1;
}
console.log(`done: ${moved} groups moved, ${skipped} skipped`);
JS
