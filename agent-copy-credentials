#!/usr/bin/env bash
# Install this account's GitHub login into the agent user's home.
# The token is in the login keyring, so copying ~/.config/gh is not enough.
# Only the github.com SSH key is copied. Other keys stay in this account.
set -euo pipefail

agent=agent
agent_home=$(getent passwd "$agent" | cut -d: -f6)
key=$HOME/.ssh/qc

if [[ -z "${agent_home}" || ! -d "${agent_home}" ]]; then
  echo "no home directory for ${agent}" >&2
  exit 1
fi
if [[ ! -f "${key}" || ! -f "${key}.pub" ]]; then
  echo "missing ${key} or ${key}.pub" >&2
  exit 1
fi

sudo -v

token=$(gh auth token)
if [[ -z "${token}" ]]; then
  echo "gh auth token returned nothing" >&2
  exit 1
fi

sudo -H -u "${agent}" \
  gh auth login \
    --with-token \
    --hostname github.com \
    --git-protocol ssh \
    --insecure-storage \
    --skip-ssh-key <<<"${token}"
unset token

sudo chmod 700 "${agent_home}/.config" "${agent_home}/.config/gh"
sudo chmod 600 "${agent_home}/.config/gh/hosts.yml"
sudo chown -R "${agent}:work" "${agent_home}/.config/gh"

sudo install -d -m 700 -o "${agent}" -g work "${agent_home}/.ssh"
sudo install -m 600 -o "${agent}" -g work "${key}" "${agent_home}/.ssh/qc"
sudo install -m 644 -o "${agent}" -g work "${key}.pub" "${agent_home}/.ssh/qc.pub"

config=$(mktemp)
known=$(mktemp)
trap 'rm -f "${config}" "${known}"' EXIT
cat >"${config}" <<'EOF'
Host github.com
  HostName github.com
  IdentityFile ~/.ssh/qc
  IdentitiesOnly yes
EOF
sudo install -m 600 -o "${agent}" -g work "${config}" "${agent_home}/.ssh/config"

if ssh-keyscan -T 5 github.com >"${known}" 2>/dev/null; then
  sudo install -m 600 -o "${agent}" -g work "${known}" "${agent_home}/.ssh/known_hosts"
fi
rm -f "${known}"

sudo -H -u "${agent}" gh auth status
